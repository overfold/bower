DATABASE_URL=postgres://bower:bower@localhost:5432/bower
# Optional durable operator connection for non-native bootstrap. Do not put
# allocation-injected TRELLIS_ADDR/TRELLIS_TOKEN values here.
TRELLIS_API_URL=
TRELLIS_API_TOKEN=
# Set to "true" to run pending Drizzle migrations automatically on startup.
# Recommended for development; omit in production where migrations should be
# applied as a controlled pre-deployment step.
AUTO_MIGRATE=true
# Stable across every instance in a multi-instance deployment.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Public origin of this Bower instance, reachable from managed ingress proxies.
BOWER_PUBLIC_URL=https://bower.example.com
# Stable random secret used for route-scoped Bower authentication grants.
# Generate with: openssl rand -hex 32
BOWER_ROUTE_AUTH_SECRET=
# Override when publishing the bundled proxy images under another registry.
BOWER_CADDY_IMAGE=ghcr.io/overfold/bower-proxy:latest
BOWER_PROXY_SYNC_IMAGE=ghcr.io/overfold/bower-proxy-sync:latest
# One shared host-networked ingress per connected cluster.
BOWER_PROXY_NAMESPACE=platform
BOWER_PROXY_HTTP_PORT=80
BOWER_PROXY_HTTPS_PORT=443
# Optional upstream for Bower outside the native trellis.yml deployment.
# Native deployments discover healthy platform/bower allocations automatically.
BOWER_PROXY_DASHBOARD_UPSTREAM=
# Server-side deployment health, canary, and auto-rollback reconciliation cadence.
BOWER_RECONCILE_INTERVAL=5
# Only instance admins are eligible to bypass multitenancy protections. Set
# this exact value to true to allow them to configure host paths and elevated
# workload API grants.
BOWER_IA_BYPASS_MULTITENANCY=false
